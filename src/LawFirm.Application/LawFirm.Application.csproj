<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Application uses the concrete LawFirmDbContext directly (no IApplicationDbContext
         abstraction), so it references Infrastructure. Infrastructure does NOT reference
         Application, keeping the graph acyclic. -->
    <ProjectReference Include="..\LawFirm.Infrastructure\LawFirm.Infrastructure.csproj" />
    <ProjectReference Include="..\LawFirm.Domain\LawFirm.Domain.csproj" />
    <ProjectReference Include="..\LawFirm.Shared\LawFirm.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
